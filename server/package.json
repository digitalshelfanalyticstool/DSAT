{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Express.js backend for Enterprise Web Scraper",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --quiet",
    "load-test": "tsx src/scripts/load-test.ts",
    "load-test:sustained": "tsx src/scripts/load-test.ts --sustained --duration 600",
    "create-admin": "node dist/scripts/create-admin.js",
    "demo": "node dist/scripts/demo.js",
    "monitor": "tsx src/scripts/monitor-system.ts --watch --interval 2",
    "monitor:log": "tsx src/scripts/monitor-system.ts --output metrics.csv --duration 3600"
  },
  "dependencies": {
    "@bull-board/api": "^6.3.0",
    "@bull-board/express": "^6.3.0",
    "@sentry/node": "^10.52.0",
    "archiver": "^5.3.2",
    "bcrypt": "^6.0.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.71.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "domhandler": "^5.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "openid-client": "6.8.8",
    "pg": "^8.20.0",
    "playwright-core": "^1.58.2",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "undici": "^7.30.1",
    "unzipper": "^0.10.14",
    "uuid": "^14.0.0",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/archiver": "^5.3.4",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.18.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/unzipper": "^0.10.11",
    "eslint": "^9.39.4",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.6.0",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
