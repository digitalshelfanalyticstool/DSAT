# =============================================================================
# Product Scraper — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Generate a strong JWT secret:
#   openssl rand -base64 32
# =============================================================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Authentication ---
# Must be at least 32 characters. Do NOT use simple dictionary-word patterns.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
TOKEN_EXPIRATION=24h

# --- PostgreSQL Database ---
# Provide EITHER a connection string OR individual vars (not both).
DATABASE_URL=postgresql://user:password@localhost:5432/scraper
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=scraper
# PGUSER=user
# PGPASSWORD=password

# Optional database tuning
# DATABASE_POOL_SIZE=15
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_SSL=false
# DATABASE_CA_CERT=/path/to/ca-cert.pem

# --- Data Storage ---
DATA_DIR=./data
STORAGE_DIR=./storage/excel

# --- Scraping provider ---
# Normally set in the UI: Admin -> Config -> Scraping provider (Direct, Apify Proxy
# or Bright Data). These env vars are only the fallback until settings are saved.
# With no Bright Data credentials below, the scraper fetches directly, optionally
# through this http(s) proxy. Most large retailers block requests without one.
# Direct and Apify launch a local Chromium, which playwright-core does not
# download: run `npx playwright-core install chromium` once on each worker host.
SCRAPER_PROXY_URL=
# How long each process caches provider settings before re-reading them (ms).
# SCRAPING_PROVIDER_CACHE_TTL_MS=30000
# URL "Test connection" fetches for Direct/Apify; should return {"ip": ...}.
# SCRAPING_PROVIDER_TEST_URL=https://api.ipify.org?format=json
# Direct, Apify and local-browser fetches refuse hosts that resolve to loopback,
# private, link-local or metadata addresses, on every redirect hop. List exact
# hostnames (comma-separated) to exempt, e.g. a retailer reached over a VPN.
# SCRAPER_ALLOWED_PRIVATE_HOSTS=
# Saving a provider in the UI encrypts its credentials with EMAIL_CONFIG_ENCRYPTION_KEY.

# --- Optional: Bright Data fallback (leave commented to use Direct) ---
# Setting the API key selects Bright Data.
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_ZONE=

# --- Redis (REQUIRED for multi-process mode) ---
# Redis connection string for BullMQ job queue and Pub/Sub progress relay
REDIS_URL=redis://localhost:6379

# --- Process Role ---
# Set to "api" for the HTTP server or "worker" for BullMQ consumer processes.
# Leave unset for single-process dev mode (backward compatible).
# PROCESS_ROLE=api

# --- Worker Configuration ---
# Number of concurrent scraping jobs per worker process (default: 13)
# WORKER_CONCURRENCY=13

# --- Scraper Configuration ---
# Number of parallel discovery runs per job (default: 2)
DISCOVERY_RUNS=3
# Max concurrent scraping jobs (default: 3)
MAX_CONCURRENT_JOBS=3

# --- Trust Proxy ---
# Number of reverse proxies in front of the API that set X-Forwarded-For.
# Default: unset (0) — X-Forwarded-For is ignored and the socket address is
# the client IP. Set 1 only when clients cannot reach the API port directly
# and the proxy overwrites X-Forwarded-For (Docker Compose sets 1 for Caddy).
# TRUST_PROXY=1

# --- Observability (Prometheus) ---
# Bearer token required to scrape /api/metrics/prometheus.
# When unset, the endpoint returns 404 (looks disabled to external
# scanners). Generate with: openssl rand -hex 32
# METRICS_BEARER_TOKEN=
# How often (ms) the API process samples BullMQ queue depth + pg pool
# counts into the registry. Default 15000. Clamped to 1000–600000.
# OBSERVABILITY_METRICS_SAMPLE_INTERVAL_MS=15000

# --- Observability (Sentry) ---
# Optional. Leave unset to disable Sentry entirely (clean no-op).
# DSN from sentry.io project settings → Client Keys (DSN).
# SENTRY_DSN=https://abc123@o000000.ingest.us.sentry.io/0000000
# Override the environment label (defaults to NODE_ENV).
# SENTRY_ENVIRONMENT=production
# Tag captured errors with the running release/version (e.g. v4.8.14).
# SENTRY_RELEASE=v4.8.14

# --- Observability (Logging) ---
# Winston log level. One of: error, warn, info, debug. Default: info.
# LOG_LEVEL=info
# Grafana Loki ingest URL. Leave unset to disable Loki shipping (logs stay
# in stdout / files only). Format: http://loki:3100 or full /loki/api/v1/push URL.
# LOKI_URL=

# --- Auth / Cookies ---
# Domain for the auth refresh-token cookie. Leave unset for same-origin
# (works in dev). Set for cross-origin deploys, e.g. ".example.com" to
# share cookies across subdomains.
# COOKIE_DOMAIN=
# Set to "true" in production to mark the refresh-token cookie Secure
# (HTTPS-only). Default: derived from NODE_ENV ("true" when production).
# COOKIE_SECURE=true
# Origins allowed by CORS. Comma-separated. Default: same-origin only.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- HTTP Rate Limits (per-route) ---
# Override the per-window request budgets for the route groups.
# Window is 15 minutes for all. Defaults: API 500, Auth 20, Admin 300,
# Metrics 120, Refresh 30 (failed refreshes only).
# RATE_LIMIT_API_MAX=500
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_ADMIN_MAX=300
# RATE_LIMIT_METRICS_MAX=120
# RATE_LIMIT_REFRESH_MAX=30
# How long the scrape-slot limiter's Redis state outlives its last acquire (ms).
# Despite the name it is not an acquire timeout. Raised to at least the lease.
# RATE_LIMIT_TIMEOUT_MS=300000
# A scrape slot held this long without release frees itself (a crashed
# worker's slot). Must outlast a job. Default: JOB_TIMEOUT_MS + 5 minutes.
# RATE_LIMIT_LEASE_TTL_MS=3900000

# --- Scraper Tuning ---
# Per-job scrape timeout (ms). Default: 3600000 (1h). Long-tail Bright Data
# discovery + PDP fetch can legitimately approach this on bad days.
# JOB_TIMEOUT_MS=3600000
# Number of consecutive scrape failures before the catalog marks a productId
# stale. Default: 3.
# MAX_CONSECUTIVE_FAILURES=3
# Retailer JSON-API request budget. Default 5 concurrent + 100ms
# minimum delay between requests. Range: concurrency 1–100, delay ≥0.
# RETAILER_API_MAX_CONCURRENCY=5
# RETAILER_API_MIN_DELAY_MS=100
# Bright Data Web Unlocker concurrent request cap (per worker). Default 13.
# UNLOCKER_CONCURRENCY=13
# Largest decoded page body a scrape fetch reads before failing it (bytes).
# Default 10485760 (10 MB).
# SCRAPER_MAX_BODY_BYTES=10485760
# Local browser pool slot acquire timeout (ms). Default 30000.
# CDP_ACQUIRE_TIMEOUT_MS=30000

# --- Image URL Backfill Job ---
# Max products processed per invocation of the admin-triggered backfill
#. Default 5000, clamp [100, 50000].
# BACKFILL_MAX_PRODUCTS=5000

# --- Queue Tuning (Persist + Excel sub-queues) ---
# Persist queue (scrape_runs + product_snapshots inserts) — runs after the
# scrape pipeline completes, off the rate-limited path.
# PERSIST_WORKER_CONCURRENCY=2
# PERSIST_JOB_TIMEOUT_MS=600000
# Snapshot bulk-insert batch size. Default 2000.
# PERSIST_BATCH_SIZE=2000
# Excel queue (xlsx generation) — separate from persist so big reports
# don't pin the persist concurrency slot.
# EXCEL_WORKER_CONCURRENCY=2
# EXCEL_JOB_TIMEOUT_MS=600000

# --- Browse Cache (read-side) ---
# Short-TTL in-process cache for `/api/products` (ProductQueryService
# .browseProducts). Default 30000 (30s); clamp [0, 600000], 0 disables.
# Tune from /admin/analytics → cache-hit-rate
# PRODUCTS_BROWSE_CACHE_TTL_MS=30000

# --- Email (admin-configurable, disabled by default) ---
# AES-256-GCM key used to encrypt provider credentials at rest in the
# email_settings table. MUST be a 64-char hex string (32 bytes).
# Generate with: openssl rand -hex 32
# Required only when email is enabled from /admin/email-settings.
# The server boots without it; the encryption helper throws on first
# encrypt/decrypt — so a deploy missing this var looks healthy until an
# admin tries to save provider credentials.
# EMAIL_CONFIG_ENCRYPTION_KEY=

# Public URL of the Next.js dashboard — used to build {{resultUrl}} in the
# job-complete email and {{dashboardUrl}} in the daily-digest email.
# Default: http://localhost:3000 (dev). Set to your public
# domain (e.g. https://scraper.example.com) when deploying.
# APP_PUBLIC_URL=http://localhost:3000
# Public origin of the API. The SSO redirect URI is <API_PUBLIC_URL>/api/auth/sso/callback.
# API_PUBLIC_URL=http://localhost:3001

# Retention window for email_log rows. Default 90 days. Sweep runs as part
# of the existing weekly DB retention pass.
# EMAIL_LOG_RETENTION_DAYS=90

# Retention window for audit_logs rows. Default 365 days. Same weekly pass.
# AUDIT_LOG_RETENTION_DAYS=365

# Daily-digest scheduler interval (ms). Default 86400000 (24 hours). Clamped
# to a 1-minute minimum so the scheduler can be sped up for staging without
# pinning the loop.
# EMAIL_DIGEST_INTERVAL_MS=86400000

# --- Process Shutdown ---
# Graceful shutdown drain window (ms). Default 3900000 (65 min) so BullMQ
# in-flight scrapes finish. Note: must align with PM2's kill_timeout in
# ecosystem.config.js.
# SHUTDOWN_TIMEOUT_MS=3900000

