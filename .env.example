# =============================================================================
# Product Scraper — Root Environment Variables
# =============================================================================
# For the full server config, see server/.env.example
# =============================================================================

# PostgreSQL Database (REQUIRED)
DATABASE_URL=postgresql://user:password@localhost:5432/scraper

# Database Pool Tuning (per process, all optional)
# DATABASE_POOL_SIZE=15                     # max connections per pool (default: 10 prod / 5 dev)
# DATABASE_IDLE_TIMEOUT_MS=30000            # idle connection timeout (default: 30000)
# DATABASE_CONNECTION_TIMEOUT_MS=5000       # connect timeout (default: 5000)
# DATABASE_STATEMENT_TIMEOUT_MS=30000       # statement timeout (default: 30000)
# DATABASE_SSL=false                        # set "true" to require TLS
# DATABASE_CA_CERT=/path/to/server-ca.pem   # custom CA cert path (optional)

# JWT Configuration (REQUIRED — server will not start without JWT_SECRET)
JWT_SECRET=your_jwt_secret_here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of allowed origins (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Auth cookie flag (optional)
# COOKIE_SECURE=true                         # force the Secure flag on auth cookies; default: true when NODE_ENV=production, else false

# Optional: Bright Data fallback (normally set in Admin -> Config -> Scraping provider).
# Setting the API key selects Bright Data; leave commented to use Direct.
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_ZONE=

# Scraping provider (Admin -> Config -> Scraping provider overrides these once saved).
# With no Bright Data credentials above, the scraper fetches directly, optionally
# through this http(s) proxy. Most large retailers block requests without one.
# Direct and Apify launch a local Chromium, which playwright-core does not
# download: run `npx playwright-core install chromium` once on each worker host.
SCRAPER_PROXY_URL=
# How long each process caches provider settings before re-reading them (ms).
# SCRAPING_PROVIDER_CACHE_TTL_MS=30000
# URL "Test connection" fetches for Direct/Apify; should return {"ip": ...}.
# SCRAPING_PROVIDER_TEST_URL=https://api.ipify.org?format=json
# Saving a provider in the UI encrypts its credentials with EMAIL_CONFIG_ENCRYPTION_KEY.

# Redis (REQUIRED for multi-process mode)
REDIS_URL=redis://localhost:6379

# Process Role — "api" for HTTP server, "worker" for BullMQ consumer
# Leave unset for single-process dev mode (backward compatible)
# PROCESS_ROLE=api

# Worker Configuration
# WORKER_CONCURRENCY=13                     # BullMQ concurrency per worker (default: 13)
# EXPECTED_WORKERS=2                        # expected worker process count for capacity math (default: 2)
# EXCEL_WORKER_CONCURRENCY=1                # excel-generation phase concurrency (default: 1)
# PERSIST_WORKER_CONCURRENCY=1              # DB persistence phase concurrency (default: 1)
# WEBHOOK_WORKER_CONCURRENCY=2              # alert-webhook deliveries in flight (default: 2)
# WEBHOOK_DELIVERY_ATTEMPTS=3               # tries per webhook delivery (default: 3)
# SCRAPE_JOB_LOCK_DURATION_MS=2700000       # BullMQ lock on a scrape job (default: 45 min)
# QUEUE_STALLED_INTERVAL_MS=300000          # BullMQ stalled-job check interval (default: 5 min)
# QUEUE_STOP_TIMEOUT_MS=30000               # queue worker drain time on stop (default: 30s)
# ALERT_IMAGE_CHECK_TIMEOUT_MS=8000         # broken-image alert: per-image GET timeout
# ALERT_IMAGE_CHECK_CONCURRENCY=8           # broken-image alert: images checked at once

# Scraper Configuration
DISCOVERY_RUNS=2

# Max consecutive failed fetches before a product is marked stale (kept in catalog for reference). Default 3.
MAX_CONSECUTIVE_FAILURES=3

# Fraction (0,1] of a PDP batch that must be extraction ERRORS (thrown parse
# failures = likely retailer schema break, not legit-empty products) before the
# live scrape logs a schema-drift alert. Default 0.5. (STAB-10)
# SCRAPER_EXTRACTION_FAILURE_ALERT_THRESHOLD=0.5

# Max products to include in a single backfill batch operation (default: 5000, range: 100–50000)
# BACKFILL_MAX_PRODUCTS=5000

# Shutdown Configuration — max time to drain in-flight BullMQ jobs on SIGTERM
# Default 3,900,000ms (65min) accommodates long-running scrape jobs; lower for faster restarts
SHUTDOWN_TIMEOUT_MS=3900000

# Storage paths
# STORAGE_DIR=./storage/excel               # excel report output directory
# STORAGE_PATH=./                           # base path for filesystem health checks
# ENV_FILE_PATH=./.env                      # path the credential-manager rewrites for runtime updates
# DATA_DIR=./data                           # base dir for on-disk data (discovery/variant JSON caches); default: <cwd>/data

# === Email integration (#454) ===
# AES-256-GCM key for encrypting SMTP credentials in email_settings.
# Required when the SMTP provider is active (set via admin UI) or a scraping
# provider is saved. Generate with: openssl rand -hex 32
EMAIL_CONFIG_ENCRYPTION_KEY=
# Public URL of the Next.js dashboard — used to build links in outbound emails (default: http://localhost:3000)
# APP_PUBLIC_URL=http://localhost:3000
# Public origin of the API. The SSO redirect URI is <API_PUBLIC_URL>/api/auth/sso/callback.
# API_PUBLIC_URL=http://localhost:3001

# Observability
# LOKI_URL=http://localhost:3100            # Grafana Loki push endpoint (optional; logs to stdout if unset)
# LOG_LEVEL=info                            # winston log level (default: info)
# HEALTH_QUEUE_DEPTH_THRESHOLD=100          # waiting scrape jobs above which /api/health reports degraded

# Scheduling
# SCHEDULE_TIMEZONE=America/New_York        # IANA zone of schedule times; set NEXT_PUBLIC_SCHEDULE_TIMEZONE in client/.env to match
# MAINTENANCE_INTERVAL_MS=604800000         # report cleanup, DB retention, web_vitals partitions (default: 7 days)
# SITE_MONITOR_STALE_RUN_MS=7200000          # a site-monitor run still "running" after this is marked failed (default: 2h)

# Auth rate limits (per IP per 15 minutes; only failures count)
# RATE_LIMIT_REFRESH_MAX=30                 # failed token refreshes

# Bandwidth cost estimate in $/GB until an admin saves one (Admin -> Bright Data) (default: 3)
# BANDWIDTH_COST_PER_GB=3

# Pipeline Speed Optimization
# See design doc for details: .kiro/specs/pipeline-speed-optimization/design.md

# Max concurrent Bright Data Web Unlocker requests (default: 12, range: 1–200)
#UNLOCKER_CONCURRENCY=12

# Minimum adaptive delay between retailer API requests in ms (default: 100, range: ≥0)
#RETAILER_API_MIN_DELAY_MS=100

# Global max concurrent requests per retailer for rate limiter (default: 15, range: 1–200)
#RATE_LIMIT_MAX_CONCURRENT=15

# A held scrape slot frees itself after this long without release (crashed worker).
# Must outlast a job (default: JOB_TIMEOUT_MS + 5 minutes)
#RATE_LIMIT_LEASE_TTL_MS=3900000

# Per-retailer rate limiter overrides (default: global value above, range: 1–200)
# Name: RATE_LIMIT_<RETAILER>_MAX_CONCURRENT, where <RETAILER> is the adapter key
# as the rate limiter keys it (see server/src/services/rate-limiter.ts).

# Local browser pool size for Direct/Apify renders (default: 3, range: 1–20)
#BROWSER_POOL_SIZE=3

# Multiplier for retry phase concurrency (default: 2, range: 1–10)
#RETRY_CONCURRENCY_MULTIPLIER=2

# Cost Optimization — Cache TTLs
# Skip discovery if last run was within this many hours (default: 24, 0=disabled)
#DISCOVERY_CACHE_TTL_HOURS=24

# Skip variant re-fetch for products already fetched within this many hours (default: 24, 0=disabled). Raising this refetches fewer products per run — direct Bright Data bandwidth cut, traded against data freshness. Tune from /admin/analytics → cache-hit-rate.
#VARIANT_CACHE_TTL_HOURS=24

# DB Retention — auto-delete old rows (days, default: 90)
# SNAPSHOT_RETENTION_DAYS also prunes alerts, image_checks and site monitor runs.
#SNAPSHOT_RETENTION_DAYS=90
#BANDWIDTH_RETENTION_DAYS=90
