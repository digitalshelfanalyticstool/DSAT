# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Build-time settings (defaults shown)
# NEXT_PUBLIC_SCHEDULE_TIMEZONE=America/New_York   # must match the server's SCHEDULE_TIMEZONE
# NEXT_PUBLIC_IDLE_SIGN_OUT_MINUTES=30              # sign out after this long without input

# --- Sentry (browser error tracking) ---
# Optional. Leave unset to disable Sentry on the client (clean no-op).
# Same DSN as the server (one project for client + server).
# NEXT_PUBLIC_*    are baked into the bundle at build time, so set these
# in client/.env.production on the deploy host (NOT .env.local — the
# deploy script removes that file before the build).
# NEXT_PUBLIC_SENTRY_DSN=https://...@oXXXX.ingest.us.sentry.io/XXXX
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_RELEASE=v4.8.14
